# Copy to .env and fill in. Never commit .env.

MONGO_URI=mongodb://localhost:27017/dermatology
PORT=5000

# Gmail SMTP (use an app password)
MAIL_HOST=smtp.gmail.com
EMAIL=you@example.com
EMAIL_PASSWORD=app-password

# Required, >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=

# Required, exactly 64 hex chars (AES-256 key for TOTP secrets). Generate: openssl rand -hex 32
# Rotating this key invalidates every doctor's authenticator enrolment.
MFA_ENCRYPTION_KEY=

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=images

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where password-reset links point (no trailing slash)
FRONTEND_URL=https://www.ankad.in

# Report fee in INR, decided server-side
REPORT_FEE_INR=299

# Comma-separated browser origins allowed to call the API with cookies.
# The API host must be same-site with these (api.ankad.in ↔ www.ankad.in).
CORS_ORIGINS=http://localhost:3000,https://www.ankad.in

# Set to production on Render: makes session cookies Secure-only.
NODE_ENV=production

# pino log level (info | warn | error | debug)
LOG_LEVEL=info
